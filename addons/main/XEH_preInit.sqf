// Runs on every machine.

// Index is tier - 1. Also used to build class and setting names.
jces_main_tierNames = ["Bronze", "Iron", "Gold", "Plasteel", "Ceramite", "Auramite"];
// Number of tiers each shield type has, counted from Bronze.
jces_main_typeTiers = createHashMapFromArray [["Personal", 6], ["Dreadnought", 3], ["Terminator", 3]];

// Shield colour by remaining health: healthy, damaged, about to break.
jces_main_healthColors = [[0, 0.55, 0.68], [1, 0.78, 0], [0.9, 0.08, 0]];
// Minimum health fraction for each colour, anything lower uses the last colour.
jces_main_healthThresholds = [0.6, 0.25];
// [outside, inside] procedural textures for each colour, the outside is a little more opaque.
jces_main_shieldTextures = jces_main_healthColors apply {
    _x params ["_red", "_green", "_blue"];
    [
        format ["#(argb,8,8,3)color(%1,%2,%3,0.15,ca)", _red, _green, _blue],
        format ["#(argb,8,8,3)color(%1,%2,%3,0.1,ca)", _red, _green, _blue]
    ]
};

// Hit flash textures, [colour][fade step], brightest first. Generated by tools/generate_hit_textures.py.
jces_main_hitTextures = [0, 1, 2] apply {
    private _colorIndex = _x;
    [0, 1, 2] apply {format ["\CalebsShields\jces_shields\Textures\Hit\jces_shield_hit_%1_%2_ca.paa", _colorIndex, _x]}
};

// Hit layer texture for each colour, see jces_hitLayer in the shield config.
jces_main_hitLayerTextures = [0, 1, 2] apply {format ["\CalebsShields\jces_shields\Textures\Hit\jces_shield_hitlayer_%1_ca.paa", _x]};

// Facewear from other mods that has no jces_shieldTier config entry, keys are lower case.
jces_main_facewearTiers = createHashMapFromArray [
    ["iron_halo_dos_s_3", 1],
    ["iron_halo_dos_3", 1],
    ["iron_halo_dos_s", 2],
    ["iron_halo_dos", 2],
    ["da_halo1", 3],
    ["iron_halo_dos_s_2", 3],
    ["iron_halo_dos_2", 3],
    ["bt_iron_halo_gold", 3],
    ["bt_ironhalo1", 3]
];

// Classname caches, filled on first use.
jces_main_ammoCache = createHashMap;
jces_main_explosiveAmmoCache = createHashMap;
jces_main_deviceCache = createHashMap;
jces_main_unitTypeCache = createHashMap;
jces_main_availableItemsCache = createHashMap;

["jces_main_activate", {
    params ["_unit"];
    [_unit] call jces_main_fnc_activate;
}] call CBA_fnc_addEventHandler;

["jces_main_toggle", {
    params ["_unit"];
    [_unit] call jces_main_fnc_toggle;
}] call CBA_fnc_addEventHandler;

// Inventory commands need the unit to be local, Zeus sends these to its owner.
["jces_main_addShieldItem", {
    params ["_unit", "_item"];
    ["main", "Adding %1 to %2", _item, _unit] call jces_main_fnc_log;
    // Drops it at the unit's feet if the inventory is full.
    [_unit, _item, true, true] call CBA_fnc_addItem;
}] call CBA_fnc_addEventHandler;

["jces_main_removeShieldItems", {
    params ["_unit"];
    ["main", "Removing shield items %1 from %2", [_unit] call jces_main_fnc_getShieldItems, _unit] call jces_main_fnc_log;
    // The shield can't stay up without its device.
    [_unit] call jces_main_fnc_deactivate;
    {
        _unit removeItems _x;
    } forEach ([_unit] call jces_main_fnc_getShieldItems);
}] call CBA_fnc_addEventHandler;

["jces_main_shieldHitEffect", {
    params ["_shield"];
    [_shield] call jces_main_fnc_playHitEffect;
}] call CBA_fnc_addEventHandler;

["jces_main_shieldHit", {
    _this call jces_main_fnc_damageShield;
}] call CBA_fnc_addEventHandler;

["jces_main_deactivate", {
    params ["_unit", "_broken"];
    [_unit, _broken] call jces_main_fnc_deactivate;
}] call CBA_fnc_addEventHandler;

// removeCuratorEditableObjects only works on the server. Shields and their crew stay out of Zeus,
// the second pass catches auto add scripts (e.g. ZEN's "Auto Add Objects") that add them a frame later.
["jces_main_removeFromCurators", {
    params ["_shield"];
    private _remove = {
        if (isNull _this) exitWith {};
        ["main", "Removing %1 and its crew from %2 curator(s)", _this, count allCurators] call jces_main_fnc_log;
        {
            _x removeCuratorEditableObjects [[_this], true];
        } forEach allCurators;
    };
    _shield call _remove;
    [_remove, _shield, 1] call CBA_fnc_waitAndExecute;
}] call CBA_fnc_addEventHandler;

// HitPart fires on the shooter's machine, so every machine needs the replacement handler.
["jces_main_patchDreadnoughtHitbox", {
    params ["_hitbox"];
    if (isNull _hitbox || {_hitbox getVariable ["jces_main_hitPartPatched", false]}) exitWith {};
    _hitbox setVariable ["jces_main_hitPartPatched", true];
    ["main", "Replacing the HitPart handler of dreadnought hitbox %1", _hitbox] call jces_main_fnc_log;
    // The dreadnought's scripted health is the first HitPart handler, swap it for one that respects the shield.
    _hitbox removeEventHandler ["HitPart", 0];
    _hitbox addEventHandler ["HitPart", {_this call jces_main_fnc_dreadnoughtHitPart}];
}] call CBA_fnc_addEventHandler;

private _modName = "JCaleb's Energy Shields";
private _coreCategory = _modName + " - Core";

{
    _x params ["_type", "_healthDefaults"];
    private _category = format ["%1 - %2", _modName, _type];
    {
        private _tierName = _x;
        private _subcategory = format ["Tier %1: %2", _forEachIndex + 1, _tierName];
        private _shieldName = format ["%1 %2 shield", _tierName, toLower _type];
        [
            format ["jces_main_health%1%2", _type, _tierName],
            "SLIDER",
            ["Health", format ["Damage a %1 absorbs before breaking. Roughly mm of RHA steel: a 5.56 mm round deals ~11, a 7.62 mm ~16, a .50 BMG ~30.", _shieldName]],
            [_category, _subcategory],
            [50, 20000, _healthDefaults select _forEachIndex, 0],
            1
        ] call CBA_fnc_addSetting;
        [
            format ["jces_main_cooldown%1%2", _type, _tierName],
            "SLIDER",
            ["Cooldown", format ["Seconds a broken or expired %1 needs to recharge. Turning it off early shortens this by what it had left.", _shieldName]],
            [_category, _subcategory],
            [5, 900, 67, 0],
            1
        ] call CBA_fnc_addSetting;
        [
            format ["jces_main_timeLimit%1%2", _type, _tierName],
            "CHECKBOX",
            ["Time Limit", format ["Turns a %1 off after Maximum Duration, even if it has health left.", _shieldName]],
            [_category, _subcategory],
            true,
            1
        ] call CBA_fnc_addSetting;
        [
            format ["jces_main_maxDuration%1%2", _type, _tierName],
            "SLIDER",
            ["Maximum Duration", format ["Seconds a %1 stays up when Time Limit is on.", _shieldName]],
            [_category, _subcategory],
            [5, 60, 15, 0],
            1
        ] call CBA_fnc_addSetting;
    } forEach (jces_main_tierNames select [0, count _healthDefaults]);
} forEach [
    // Health grows ~35% per tier, dreadnoughts get 4x and terminators 2x. Cooldown and duration are the same for every tier.
    ["Personal", [600, 810, 1093, 1475, 1992, 2690]],
    ["Dreadnought", [2400, 3240, 4372]],
    ["Terminator", [1200, 1620, 2186]]
];

[
    "jces_main_minimumCooldown",
    "SLIDER",
    ["Minimum Cooldown", "Seconds before a shield turned off with everything left can be used again."],
    [_coreCategory, "Damage"],
    [0, 60, 10, 0],
    1
] call CBA_fnc_addSetting;

[
    "jces_main_kineticMultiplier",
    "SLIDER",
    ["Kinetic Damage Multiplier", "Scales damage from a round's penetration: typicalSpeed * (typicalSpeed / 1000) * caliber * 15 / 1000 * (1 - explosive)."],
    [_coreCategory, "Damage"],
    [0, 20, 1, 2],
    1
] call CBA_fnc_addSetting;

[
    "jces_main_explosiveMultiplier",
    "SLIDER",
    ["Explosive Damage Multiplier", "Scales damage from explosions: explosive * hit for direct hits, explosive * indirectHit for splash, dropping off outside indirectHitRange."],
    [_coreCategory, "Damage"],
    [0, 20, 1, 2],
    1
] call CBA_fnc_addSetting;

[
    "jces_main_ignoreFriendlyFire",
    "CHECKBOX",
    ["Ignore Friendly Fire", "Shields take no damage from friendly units, e.g. squadmates shooting out from inside a dreadnought shield."],
    [_coreCategory, "Damage"],
    true,
    1
] call CBA_fnc_addSetting;

[
    "jces_main_rapidFireEnabled",
    "CHECKBOX",
    ["Rapid Fire Reduction", "Repeated hits from the same ammo type within the Rapid Fire Window deal less damage, so fast-firing weapons can't melt a shield. A single heavy hit (e.g. a tank shell) still deals full damage."],
    [_coreCategory, "Damage"],
    true,
    1
] call CBA_fnc_addSetting;

[
    "jces_main_rapidFireWindow",
    "SLIDER",
    ["Rapid Fire Window", "Seconds a hit is remembered. Hits from the same ammo type within this many seconds count as repeats."],
    [_coreCategory, "Damage"],
    [0.1, 5, 1, 1],
    1
] call CBA_fnc_addSetting;

[
    "jces_main_rapidFireFactor",
    "SLIDER",
    ["Rapid Fire Factor", "How much each repeat reduces damage: a hit deals damage / (1 + repeats * factor). At 1, the 30th hit within the window deals 1/30 of its damage; at 0.5, 1/15.5."],
    [_coreCategory, "Damage"],
    [0.05, 3, 1, 2],
    1
] call CBA_fnc_addSetting;

// Only the automatic AI behaviour, Zeus and scripts can still raise AI shields.
private _aiCategory = _modName + " - AI";

[
    "jces_main_aiEnabled",
    "CHECKBOX",
    ["AI Uses Shields", "AI carrying a shield device raise it on their own when hit, near an enemy explosive or suppressed."],
    _aiCategory,
    true,
    1
] call CBA_fnc_addSetting;

{
    _x params ["_trigger", "_title", "_tooltip", "_default"];
    [
        format ["jces_main_aiChance%1", _trigger],
        "SLIDER",
        [_title, _tooltip + " Rolled again at most once per Re-roll Interval."],
        [_aiCategory, "Chance to Raise"],
        [0, 1, _default, 0, true],
        1
    ] call CBA_fnc_addSetting;
} forEach [
    ["Hit", "When Hit", "Chance an AI raises its shield when it takes a hit.", 0.75],
    ["Explosion", "Enemy Explosive", "Chance an AI raises its shield when an enemy fires a grenade, launcher or shell nearby.", 0.5],
    ["Suppressed", "Suppressed", "Chance an AI raises its shield when enemy fire passes close by.", 0.25]
];

[
    "jces_main_aiRollInterval",
    "SLIDER",
    ["Re-roll Interval", "Seconds before the same kind of danger can roll again for a unit. Lower makes AI raise shields sooner under sustained fire."],
    [_aiCategory, "Chance to Raise"],
    [0.5, 30, 3, 1],
    1
] call CBA_fnc_addSetting;

[
    "jces_main_hitEffects",
    "CHECKBOX",
    ["Hit Effects", "Shields without a Hit layer (dreadnought and terminator) flash with lightning when hit. Turn off to save a little performance."],
    [_coreCategory, "Effects"],
    true,
    0
] call CBA_fnc_addSetting;

// Per machine, so a single client (or the server through its own settings) can log without flooding everyone's RPT.
[
    "jces_main_debug",
    "CHECKBOX",
    ["Debug Logging", "Writes everything the mod does on this machine to the RPT, prefixed with [JCES]. For hunting bugs, e.g. in multiplayer compare the RPTs of the machines involved."],
    [_coreCategory, "Debug"],
    false,
    0,
    {
        params ["_enabled"];
        if (_enabled) then {
            ["main", "Debug logging enabled, player %1, mission %2", profileName, missionName] call jces_main_fnc_log;
        };
    }
] call CBA_fnc_addSetting;

// Sounds only play for the shield's owner, so these are per player.
private _soundCategory = _modName + " - Sounds";
private _soundFolder = "\CalebsShields\jces_shields\Sounds\";

[
    "jces_main_soundsEnabled",
    "CHECKBOX",
    ["Enable Sounds", "Plays a sound when your shield turns on, turns off, is depleted and is ready again. Only you hear them."],
    _soundCategory,
    true,
    0
] call CBA_fnc_addSetting;

{
    _x params ["_action", "_title", "_tooltip", "_default"];
    [
        format ["jces_main_sound%1", _action],
        "EDITBOX",
        [_title, _tooltip + " Path to a .wss, .ogg or .wav file, leave empty for no sound."],
        _soundCategory,
        _soundFolder + _default,
        0
    ] call CBA_fnc_addSetting;
} forEach [
    ["Activate", "Turning On", "Played when your shield turns on.", "shield_on.ogg"],
    ["Deactivate", "Turning Off", "Played when your shield is turned off or its time runs out.", "shield_off.ogg"],
    ["Depleted", "Depleted", "Played when your shield breaks.", "shield_hit5.ogg"],
    ["Ready", "Ready", "Played when your shield has recharged.", "shield_ready.ogg"]
];

if (!hasInterface) exitWith {};

// 37 is DIK_K, modifiers are [shift, ctrl, alt].
[_modName, "jces_main_toggleKey", ["Toggle Shield", "Activates the shield, or turns it off early for a shorter cooldown."], {
    [call CBA_fnc_currentUnit] call jces_main_fnc_toggle
}, {}, [37, [true, true, false]]] call CBA_fnc_addKeybind;
